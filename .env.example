# WhatsApp AI Automation — environment configuration (docker compose + native)
# Copy to .env and fill in real values. NEVER commit .env.
#
#   cp .env.example .env
#   docker compose up -d --build

# ── Host port mapping (docker compose only) ─────────────────────
# Change these if 3001/3002 are already taken on your host.
WEBHOOK_HOST_PORT=3001
ROUTER_HOST_PORT=3002

# ── WhatsApp provider (pick ONE) ──────────────────────────────
# 'meta'    = Official WhatsApp Business Cloud API (default).
#             Requires: Meta developer account, business verification,
#             WHATSAPP_TOKEN + WHATSAPP_PHONE_ID below.
# 'baileys' = Unofficial via a Baileys bridge (WA_PROVIDER=baileys).
#             Free, uses your personal WhatsApp number via QR pairing.
#             Requires a running Baileys bridge (BAILEYS_BRIDGE below).
#             Note: unofficial — risk of number bans; use at your own risk.
WA_PROVIDER=meta

# ── Webhook server (webhook/server.js) ────────────────────────
# Container-internal port (host port = WEBHOOK_HOST_PORT above)
PORT=3001
# Bind address for webhook server. Loopback by default (put a TLS reverse
# proxy in front); compose sets 0.0.0.0 inside the container only.
HOST=127.0.0.1
# Meta webhook verify token — generate: openssl rand -hex 32
# REQUIRED: server exits without it (fail-closed)
VERIFY_TOKEN=
# Meta App Secret (App Dashboard → Settings → Basic) — verifies
# X-Hub-Signature-256 on POST /webhook. REQUIRED (fail-closed):
# without it POST /webhook returns 503 — no unverified payloads accepted.
APP_SECRET=
#
# Shared secret required in X-API-Key header for all /api/* routes
# (processor ↔ webhook). Generate: openssl rand -hex 32
# REQUIRED (fail-closed): without it every /api/* route returns 503.
API_KEY=
#
# WhatsApp Cloud API credentials (from Meta developers portal)
# Required when WA_PROVIDER=meta. See docs/meta-cloud-api-setup.md
# for where to find each value.
WHATSAPP_TOKEN=
#
# Baileys bridge base URL (required when WA_PROVIDER=baileys)
BAILEYS_BRIDGE=http://127.0.0.1:3000

# ── AI processor (webhook/processor.js — optional worker) ─────
# LLM backend keys (pick at least one)
XIAOMI_API_KEY=
DEEPSEEK_API_KEY=
# Local llama.cpp server (optional, zero-cost)
LOCAL_MODEL_URL=http://127.0.0.1:8081/v1/chat/completions
# System prompt with YOUR product data (name, price, stock, shipping)
SYSTEM_PROMPT=
# Comma-separated WhatsApp numbers allowed to query personal data
AUTHORIZED_NUMBERS=
# Comma-separated owner numbers exempt from daily limits
UNLIMITED_NUMBERS=
# Worker queue integration
POWER_TOOL_API=http://localhost:5557

# ── myinfo personal data hub (webhook/myinfo.py) ──────────────
MYINFO_DB=~/.myinfo/data.db

# ── Router (router/) ──────────────────────────────────────────
ROUTER_PORT=3002
WEBHOOK_PORT=3003
# Only set BIND_HOST=0.0.0.0 when you deliberately want the router
# reachable outside the machine (e.g. inside Docker). Default: 127.0.0.1
BIND_HOST=127.0.0.1
POWER_TOOL_API=http://localhost:5557/api/dispatch
TELEGRAM_NOTIFY=http://localhost:3001/api/telegram/notify
# Routing maps as JSON (or use routing.json next to the scripts)
WHATSAPP_GROUPS_JSON={}
TELEGRAM_CHANNELS_JSON={}
WHATSAPP_BRIDGE=http://127.0.0.1:3000

# ── Deployment topology ────────────────────────────────────────
# CONSOLIDATED (single VPS, recommended): all services on 127.0.0.1,
#   reverse-proxy 80/443 with TLS. Requires a VPS/dedicated server —
#   shared hosting cannot run these daemons.
# SPLIT (edge + brain): edge runs only server.js (VERIFY_TOKEN,
#   WHATSAPP_TOKEN) and forwards to the brain over outbound HTTPS.
#   Brain runs processor/router/workers with no public ports.
#   See README "Deployment Topologies".
